<data inherit_id="sale.report_saleorder_document" priority="50">
    <xpath expr="//th[@name='th_quantity']" position="before">
        <t t-set="display_hs_code" t-value="any(l.hs_code for l in lines_to_report.product_id)"/>
        <th name="th_hs_code" class="text-start" t-if="display_hs_code">
            <span>HS-Code</span>
        </th>
    </xpath>
    <xpath expr="//td[@name='td_quantity']" position="before">
        <td name="td_hs_code" class="text-start">
            <span t-field="line.product_id.hs_code"/>
        </td>
    </xpath>
</data>