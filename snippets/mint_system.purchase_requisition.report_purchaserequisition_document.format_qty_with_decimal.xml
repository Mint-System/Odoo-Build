<data priority="50">
    <xpath expr="//span[@id='qty']" position="replace">
        <t t-if="line_ids.product_uom_id.id == 1">
            <span id="qty" t-field="line_ids.product_qty" t-options="{'widget': 'integer'}"/>
        </t>
        <t t-else="">
            <span id="qty" t-field="line_ids.product_qty"/>
        </t>
    </xpath>
</data>