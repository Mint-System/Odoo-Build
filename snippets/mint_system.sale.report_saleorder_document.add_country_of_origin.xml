<data inherit_id="account.report_invoice_document" priority="60">
    <xpath expr="//th[@name='th_quantity']" position="before">
        <t t-set="display_country_of_origin" t-value="any(l.hs_code for l in lines_to_report.product_id)"/>
        <th name="th_country_of_origin" class="text-start" t-if="display_country_of_origin">
            <span>Origin</span>
        </th>
    </xpath>
    <xpath expr="//td[@name='td_quantity']" position="before">
        <t t-set="display_country_of_origin" t-value="any(l.hs_code for l in lines_to_report.product_id)"/>
        <td name="td_country_of_origin" class="text-start" t-if="display_country_of_origin">
            <span t-esc="line.product_id.country_of_origin.code"/>
        </td>
    </xpath>
</data>